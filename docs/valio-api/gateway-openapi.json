    },
    "required": [
     "product_id",
     "quantity"
    ],
    "title": "QuoteRequest",
    "type": "object"
   },
   "SandboxOrder": {
    "properties": {
     "idempotency_key": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
     },
     "product_id": {
      "title": "Product Id",
      "type": "string"
     },
     "quantity": {
      "maximum": 100000.0,
      "minimum": 1.0,
      "title": "Quantity",
      "type": "integer"
     }
    },
    "required": [
     "product_id",
     "quantity",
     "idempotency_key"
    ],
    "title": "SandboxOrder",
    "type": "object"
   },
   "SandboxQuestion": {
    "properties": {
     "reason": {
      "default": "",
