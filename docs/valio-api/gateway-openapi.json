 "info": {
  "description": "Lookup, quote, order, order state and audit for an outside buying agent. Every /gateway call but /gateway/key needs the licence of the Agent Driving Test as a Bearer token. Quotes and order answers are signed with Ed25519.",
  "title": "Aimo Agent Gateway",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
