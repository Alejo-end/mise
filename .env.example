# Every setting the Valio backend reads, with its default and meaning.
# Copy to valio-challenge/.env (git ignores .env) and fill in only what you need.
# An empty value or a missing line means the default. Never commit a filled-in copy.
#
# The live .env should hold only secrets and site values (the first two groups).
# The policy values in the last group are committed in backend/settings.py; the tests run
# with exactly those defaults. Set one here only on purpose: the backend then logs a
# "Settings differ from the committed defaults" notice at start.

# --- Secrets (no default; keep out of git) -----------------------------------
# Approver PINs and names, "PIN:Name" pairs separated by commas, e.g. 1234:Head chef.
# Without it nobody can approve (POST /approvals answers 503).
APPROVER_PINS=
# Demo only: 1 shows the approver PINs on the page, so that a visitor can approve. A shown PIN protects nothing.
SHOW_PINS=
# Demo only: minutes that the air may be above a product's limit before the alert. It replaces the rule set's value.
COLD_ALLOWED_MINUTES=
# The kitchen's own storage limit for products whose catalog entry has none: product id and °C, e.g. 464316:6,463335:6
COLD_LIMITS=
# Key for Valio's price and availability API (from the challenge page). Needed for CATALOG=valio.
VALIO_API_KEY=
# Lets a real language model take the Agent Driving Test ({"agent": "claude"} on POST /sandbox/test).
ANTHROPIC_API_KEY=

# --- Site values ---------------------------------------------------------------
# Catalog: "local" (stand-in), "valio" (real product file + live API; needs VALIO_API_KEY and the file),
# or empty: valio when both the key and the product file exist, else local.
CATALOG=
# The signed rule set. Use rules/school_kitchen_valio.yaml with CATALOG=valio.
RULES_FILE=rules/school_kitchen.yaml
# The append-only audit log (SQLite). Each worktree uses its own file, see docs/PARALLEL_WORK.md.
AUDIT_DB=data/audit.sqlite
# The gateway's Ed25519 signing key; created on first start if missing.
GATEWAY_KEY=data/gateway_key.pem
# Folder with Valio's product file (never committed).
VALIO_DATA_DIR=data/valio
# Valio API base URL and customer number.
VALIO_BASE_URL=https://junction26.valioaimo.fi
VALIO_CUSTOMER=123
# Folder that keeps every live price and availability call (request and answer, never the key), read-only.
# Empty: no recording. Worker 3 used valio-source-data/2026-11-14/api-recordings (now locked read-only).
VALIO_RECORD_DIR=
# Most live calls to Valio's API this backend process may make. Empty: no cap.
VALIO_MAX_CALLS=
# The model that takes the Driving Test when ANTHROPIC_API_KEY is set.
DRIVING_TEST_MODEL=claude-opus-5-5

# --- Policy (committed defaults in backend/settings.py) ------------------------
# Restock policy, decision C in docs/PARALLEL_WORK.md. After an order for a shelf slot, the slot
# stays pending (no second order) until a delivery check for the order arrives, or the slot reads
# stocked without a break for RESTOCK_CONFIRM_S and at least RESTOCK_MIN_S after the order.
# This is a mitigation against a hand or a recalibration, not proof of a delivery.
# Seconds after the order before a stocked slot can end the pending order.
RESTOCK_MIN_S=120
# Seconds the slot must read stocked without a break (the board reports every 10 s).
# 0 = no hold: one stocked reading after RESTOCK_MIN_S ends it (Alejo's original spec, with RESTOCK_MIN_S=0).
RESTOCK_CONFIRM_S=60
# Seconds without any event before the shelf box counts as offline.
OFFLINE_AFTER_S=30
# Seconds after which the board's last health report counts as unknown; a gap this long between
# two stocked readings starts the hold again.
HEALTH_STALE_S=30
# Seconds: a health report whose newest camera frame is older than this is no evidence of stock
# (the camera may hang while the board repeats its last reading).
FRAME_STALE_S=10

# Shelf recording session id (tools/record_sequence.py). Set only while recording the shelf: device events
# are logged but never reach the agent (no trigger, order or approval). Empty = normal operation.
RECORDING_SESSION=
