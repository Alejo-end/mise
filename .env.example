# Copy this file to .env and fill in the values. Git ignores .env. Never commit it.
# Share the real PINs in person, not in the repository.

# Approver PINs: four digits and a name, separated by commas. Any PIN can approve an order and grant a licence.
APPROVER_PINS=0000:Head chef,0000:Sous chef,0000:Valio admin

# Optional: the Valio challenge catalog and its mock API. See HANDBOOK.md, "Run it".
# VALIO_API_KEY=
# CATALOG=valio
# RULES_FILE=rules/school_kitchen_valio.yaml

# Optional: a real language model takes the Agent Driving Test.
# ANTHROPIC_API_KEY=
